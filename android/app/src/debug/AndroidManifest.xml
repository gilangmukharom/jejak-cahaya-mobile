<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ memblokir HTTP polos secara bawaan, sementara backend saat
         pengembangan berjalan di `http://<IP-LAN>:3000` tanpa TLS. Tanpa baris
         ini setiap permintaan gagal dengan CLEARTEXT_NOT_PERMITTED.

         Hanya berlaku untuk build debug — manifest release tidak memuatnya,
         sehingga aplikasi yang dirilis tetap mewajibkan HTTPS. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
