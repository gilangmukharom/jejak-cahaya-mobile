<?xml version="1.0" encoding="utf-8"?>
<!--
  Kebijakan jaringan build debug: HTTP polos diizinkan ke mana pun, karena
  backend saat pengembangan berjalan di http://<IP-LAN>:3000 tanpa TLS.

  Berkas ini wajib ada selama build release memakai networkSecurityConfig:
  begitu atribut itu terpasang, Android 7+ mengabaikan
  android:usesCleartextTraffic pada manifest debug — tanpa berkas ini setiap
  permintaan ke backend lokal gagal dengan CLEARTEXT_NOT_PERMITTED.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
