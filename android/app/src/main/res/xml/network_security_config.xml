<?xml version="1.0" encoding="utf-8"?>
<!--
  Kebijakan jaringan build release.

  Seluruh lalu lintas ke luar perangkat tetap wajib HTTPS. Satu-satunya
  pengecualian adalah loopback: penampil 3D cadangan (model_viewer_plus, dipakai
  di perangkat tanpa ARCore) menjalankan server HTTP kecil di 127.0.0.1 untuk
  menyajikan halaman <model-viewer> ke WebView-nya sendiri. Lalu lintas itu
  tidak pernah meninggalkan perangkat.

  Build debug menimpa berkas ini dengan versinya sendiri di
  src/debug/res/xml/ — di sana HTTP polos ke IP LAN masih diizinkan.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
